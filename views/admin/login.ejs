<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0b2b24">
  <title>Administrator Sign In | Gracious Senior Living</title>
  <link rel="icon" type="image/png" href="/media/brand/gracious-logo.png">
  <link rel="apple-touch-icon" href="/media/brand/gracious-logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-visual">
      <div class="auth-overlay"></div>
      <div class="auth-brand"><img class="auth-brand-logo" src="/media/brand/gracious-logo.png" alt="Gracious Senior Living"></div>
      <div class="auth-message"><span class="auth-kicker"><i class="fa-solid fa-shield-heart"></i> Secure workspace</span><h1>Care for the website with the same attention given to every family.</h1><p>Manage conversations, inquiries, reviews and community content from one calm, organized workspace.</p></div>
      <div class="auth-quote"><i class="fa-solid fa-quote-left"></i><span><strong>Grace in every detail.</strong><small>Gracious Senior Living Administration</small></span></div>
    </section>
    <section class="auth-form-side">
      <div class="login-card">
        <a class="back-site" href="/"><i class="fa-solid fa-arrow-left"></i> Back to public website</a>
        <img class="mobile-auth-mark" src="/media/brand/gracious-logo.png" alt="Gracious Senior Living">
        <div class="login-heading"><span>Administrator access</span><h2>Welcome back.</h2><p>Sign in with your Gracious administration account.</p></div>
        <% if(error){ %><div class="admin-notice error"><span><i class="fa-solid fa-circle-exclamation"></i><%=error%></span></div><% } %>
        <form method="post" action="/admin/login" class="login-form">
          <label class="admin-field"><span>Email address</span><span class="input-icon"><i class="fa-regular fa-envelope"></i><input required type="email" name="email" autocomplete="username" placeholder="info@graciouscarenc.com" autofocus></span></label>
          <div class="admin-field"><label for="adminPassword">Password</label><span class="input-icon password-field"><i class="fa-solid fa-lock"></i><input id="adminPassword" required type="password" name="password" autocomplete="current-password" placeholder="Enter your password"><button type="button" data-password-toggle aria-label="Show password"><i class="fa-regular fa-eye"></i></button></span></div>
          <button class="admin-btn primary login-submit" type="submit"><span>Sign In Securely</span><i class="fa-solid fa-arrow-right"></i></button>
        </form>
        <div class="login-security"><i class="fa-solid fa-lock"></i><span><strong>Protected administration area</strong><small>Your session is encrypted and automatically expires.</small></span></div>
      </div>
    </section>
  </main>
  <script src="/js/admin.js"></script>
</body>
</html>
