<%- include('../partials/admin-head',{title}) %>
<% const settingMeta = { siteName:{label:'Website name',icon:'fa-signature',help:'Used as the public identity of the residence.'}, address:{label:'Street address',icon:'fa-location-dot',help:'Displayed in the header, footer and contact page.'}, phone:{label:'Main phone',icon:'fa-phone',help:'The primary number families should call.'}, mobile:{label:'Mobile phone',icon:'fa-mobile-screen',help:'An optional secondary contact number.'}, email:{label:'Contact email',icon:'fa-envelope',help:'Used throughout the public website.'}, careersEmail:{label:'Careers email',icon:'fa-user-tie',help:'Used for employment and application correspondence.'}, liveChatEnabled:{label:'Live chat availability',icon:'fa-comments',help:'Show or hide the visitor chat widget across the website.'} }; %>
<form method="post" action="/admin/settings" class="settings-layout">
  <div class="settings-main">
    <section class="admin-panel settings-section"><header class="panel-heading"><div><span class="panel-icon"><i class="fa-solid fa-address-card"></i></span><div><h2>Residence information</h2><p>Keep public contact information accurate and consistent.</p></div></div></header><div class="settings-grid">
      <% settings.filter(s=>['siteName','address','phone','mobile','email','careersEmail'].includes(s.key)).forEach(s=>{ const meta=settingMeta[s.key]||{}; %><label class="setting-card <%=s.key==='address'?'wide':''%>"><span class="setting-icon"><i class="fa-solid <%=meta.icon||'fa-sliders'%>"></i></span><span class="setting-copy"><strong><%=meta.label||s.key%></strong><small><%=meta.help||'Website setting'%></small><input name="<%=s.key%>" value="<%=s.value%>" type="<%=s.key==='email'||s.key==='careersEmail'?'email':s.key==='phone'||s.key==='mobile'?'tel':'text'%>"></span></label><% }) %>
    </div></section>
    <section class="admin-panel settings-section hero-settings-callout"><header class="panel-heading"><div><span class="panel-icon"><i class="fa-solid fa-panorama"></i></span><div><h2>Hero sections &amp; sliders</h2><p>Hero backgrounds, slider images, headlines and buttons are managed in their dedicated workspace.</p></div></div><a class="admin-btn subtle small" href="/admin/heroes"><i class="fa-solid fa-arrow-up-right-from-square"></i> Manage Hero Sections</a></header></section>
    <% const otherSettings = settings.filter(s=>!['siteName','address','phone','mobile','email','careersEmail','heroTitle','heroText','liveChatEnabled'].includes(s.key)); if(otherSettings.length){ %><section class="admin-panel settings-section"><header class="panel-heading"><div><span class="panel-icon"><i class="fa-solid fa-puzzle-piece"></i></span><div><h2>Additional settings</h2><p>Other values available to the public website.</p></div></div></header><div class="settings-stack"><%otherSettings.forEach(s=>{%><label class="admin-field"><span><%=s.label||s.key%></span><input name="<%=s.key%>" value="<%=s.value%>"></label><%})%></div></section><% } %>
  </div>
  <aside class="settings-side" aria-label="Settings actions and status">
    <section class="admin-panel chat-setting"><span class="setting-large-icon"><i class="fa-regular fa-comments"></i></span><h2>Live visitor chat</h2><p>Allow families to begin a real-time conversation from any public page.</p><% const chatSetting=settings.find(s=>s.key==='liveChatEnabled'); %><label class="admin-field"><span>Chat widget status</span><select name="liveChatEnabled"><option value="true" <%=chatSetting?.value!=='false'?'selected':''%>>Enabled</option><option value="false" <%=chatSetting?.value==='false'?'selected':''%>>Disabled</option></select></label><div class="setting-status"><i></i><span><strong><%=chatSetting?.value==='false'?'Currently hidden':'Currently visible'%></strong><small>Changes take effect after saving.</small></span></div></section>
    <section class="admin-panel settings-help"><i class="fa-solid fa-circle-info"></i><h3>Before you save</h3><p>Review phone numbers, email and address carefully. These values appear in several public locations.</p><a href="/" target="_blank" rel="noopener">Preview website <i class="fa-solid fa-arrow-up-right-from-square"></i></a></section>
    <button class="admin-btn primary save-settings" type="submit"><i class="fa-solid fa-floppy-disk"></i> Save All Settings</button>
  </aside>
</form>
<%- include('../partials/admin-foot') %>
