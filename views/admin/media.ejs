<%- include('../partials/admin-head',{title}) %>
<% const imageCount = media.filter(item => item.type === 'image').length; const videoCount = media.filter(item => item.type === 'video').length; const activeCount = media.filter(item => item.active).length; %>
<section class="media-summary"><article><span><i class="fa-regular fa-images"></i></span><div><strong><%= imageCount %></strong><small>Photographs</small></div></article><article><span><i class="fa-solid fa-film"></i></span><div><strong><%= videoCount %></strong><small>Videos</small></div></article><article><span><i class="fa-solid fa-eye"></i></span><div><strong><%= activeCount %></strong><small>Visible items</small></div></article><a class="admin-btn primary" href="#add-media"><i class="fa-solid fa-plus"></i> Add New Media</a></section>

<section class="admin-panel upload-panel" id="add-media">
  <header class="panel-heading"><div><span class="panel-icon"><i class="fa-solid fa-cloud-arrow-up"></i></span><div><h2>Add to the media library</h2><p>Upload a local file or provide a direct media URL.</p></div></div><span class="file-limit"><i class="fa-solid fa-circle-info"></i> Maximum file size: 50 MB</span></header>
  <form class="media-upload-form" method="post" action="/admin/media" enctype="multipart/form-data">
    <div class="upload-source">
      <label class="drop-zone" data-file-drop><input id="mediaFile" type="file" name="file" accept="image/*,video/*" data-file-input><span class="drop-icon"><i class="fa-solid fa-arrow-up-from-bracket"></i></span><strong>Drop a photo or video here</strong><small>or select a file from your computer</small><em>JPG, PNG, WEBP, GIF or MP4</em><span class="file-preview" data-file-preview hidden></span></label>
      <div class="upload-divider"><span>or use a URL</span></div>
      <label class="admin-field"><span>External media URL</span><span class="input-icon"><i class="fa-solid fa-link"></i><input name="url" type="url" placeholder="https://example.com/photo.jpg"></span><small>Use a direct link to an image or video file.</small></label>
    </div>
    <div class="media-details">
      <div class="field-grid"><label class="admin-field"><span>Media type *</span><select name="type" required><option value="image">Photograph</option><option value="video">Video</option></select></label><label class="admin-field"><span>Display order</span><input type="number" name="sortOrder" value="0" min="0"><small>Lower numbers appear first.</small></label></div>
      <label class="admin-field"><span>Title</span><input name="title" maxlength="120" placeholder="A clear title for this item"></label>
      <label class="admin-field"><span>Caption</span><textarea name="caption" maxlength="300" rows="3" placeholder="Optional context shown with this media"></textarea></label>
      <label class="admin-field"><span>Alternative text</span><input name="alt" maxlength="180" placeholder="Describe the image for accessibility"><small>Important for visitors who use screen readers.</small></label>
      <label class="admin-field"><span>Video poster URL</span><input name="posterUrl" type="url" placeholder="Optional preview image for a video"></label>
      <button class="admin-btn primary submit-media" type="submit"><i class="fa-solid fa-plus"></i> Add to Library</button>
    </div>
  </form>
</section>

<section class="admin-panel library-panel">
  <header class="panel-heading compact"><div><span class="panel-icon"><i class="fa-regular fa-folder-open"></i></span><div><h2>Current media</h2><p>Hide or show any photograph or video. Visibility controls what appears in the public galleries.</p></div></div><div class="media-toolbar"><div class="toolbar-search compact"><i class="fa-solid fa-magnifying-glass"></i><input type="search" placeholder="Search media…" aria-label="Search media" data-list-search="mediaList"></div><div class="toolbar-filter compact"><i class="fa-solid fa-filter"></i><select aria-label="Filter media by visibility" data-list-status="mediaList"><option value="all">All media</option><option value="visible">Visible</option><option value="hidden">Hidden</option></select></div></div></header>
  <% if (media.length) { %><div class="media-library-grid" id="mediaList" data-filter-list>
    <% media.forEach(m=>{ %><article class="media-admin-card <%= m.active ? '' : 'is-hidden' %>" id="media-<%= m.id %>" data-filter-item data-status="<%= m.active ? 'visible' : 'hidden' %>" data-search="<%= ((m.title || '') + ' ' + (m.caption || '') + ' ' + m.type).toLowerCase() %>">
      <div class="media-preview"><% if(m.type==='image'){ %><img src="<%=m.url%>" alt="<%=m.alt||m.title||''%>" loading="lazy"><% }else{ %><% if(m.posterUrl){ %><img src="<%=m.posterUrl%>" alt="Video poster"><% } else { %><span class="video-placeholder"><i class="fa-solid fa-film"></i></span><% } %><i class="media-play fa-solid fa-play"></i><% } %><span class="media-type"><i class="fa-solid <%=m.type==='image'?'fa-image':'fa-film'%>"></i> <%=m.type%></span><span class="visibility <%=m.active?'active':'inactive'%>"><i></i><%=m.active?'Visible':'Hidden'%></span></div>
      <div class="media-card-body"><div class="media-card-title"><div><h3><%=m.title||'Untitled '+m.type%></h3><p><%=m.caption||'No caption provided.'%></p></div><span>#<%=m.sortOrder%></span></div><form class="media-visibility-form" method="post" action="/admin/media/<%=m.id%>/visibility"><input type="hidden" name="active" value="<%= m.active ? 'false' : 'true' %>"><button class="media-visibility-action <%= m.active ? 'hide' : 'show' %>" type="submit"><i class="fa-solid <%= m.active ? 'fa-eye-slash' : 'fa-eye' %>"></i><span><strong><%= m.active ? 'Hide from website' : 'Show on website' %></strong><small><%= m.active ? 'Remove from the public gallery' : 'Restore to the public gallery' %></small></span></button></form><details><summary><i class="fa-solid fa-pen"></i> Edit details <i class="fa-solid fa-chevron-down"></i></summary><form class="media-edit-form" method="post" action="/admin/media/<%=m.id%>"><label class="admin-field"><span>Title</span><input name="title" maxlength="120" value="<%=m.title||''%>"></label><label class="admin-field"><span>Caption</span><textarea name="caption" maxlength="300" rows="2"><%=m.caption||''%></textarea></label><label class="admin-field"><span>Alternative text</span><input name="alt" maxlength="180" value="<%=m.alt||''%>"></label><% if(m.type==='video'){ %><label class="admin-field"><span>Poster URL</span><input name="posterUrl" value="<%=m.posterUrl||''%>"></label><% } %><label class="admin-field"><span>Display order</span><input type="number" name="sortOrder" value="<%=m.sortOrder%>" min="0"></label><button class="admin-btn primary small" type="submit"><i class="fa-solid fa-floppy-disk"></i> Save Changes</button></form></details><form class="media-delete" method="post" action="/admin/media/<%=m.id%>?_method=DELETE" data-confirm="Delete this media item permanently?"><button type="submit"><i class="fa-regular fa-trash-can"></i> Delete item</button></form></div>
    </article><% }) %>
  </div><div class="filter-empty" data-filter-empty hidden><i class="fa-solid fa-magnifying-glass"></i><h3>No matching media</h3><p>Try another search term.</p></div>
  <% } else { %><div class="admin-empty"><span><i class="fa-regular fa-images"></i></span><h2>Your media library is empty</h2><p>Use the form above to add the first photograph or video.</p><a class="admin-btn primary" href="#add-media">Add Media</a></div><% } %>
</section>
<%- include('../partials/admin-foot') %>
