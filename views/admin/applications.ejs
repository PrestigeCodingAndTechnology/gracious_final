<%- include('../partials/admin-head',{title}) %>
<% const statusLabel = value => ({'new':'New','reviewing':'Reviewing','interview':'Interview','hired':'Hired','not-selected':'Not selected'}[value] || value); %>
<% const answer = value => value === 'yes' ? 'Yes' : value === 'no' ? 'No' : 'Not provided'; %>

<section class="application-metrics" aria-label="Application status overview">
  <% [['new','fa-inbox'],['reviewing','fa-magnifying-glass'],['interview','fa-calendar-check'],['hired','fa-user-check'],['not-selected','fa-user-xmark']].forEach(([key,icon]) => { %>
    <a class="application-metric <%= status === key ? 'active' : '' %>" href="/admin/applications?status=<%= key %>"><span><i class="fa-solid <%= icon %>"></i></span><div><strong><%= counts[key] || 0 %></strong><small><%= statusLabel(key) %></small></div></a>
  <% }) %>
</section>

<form class="admin-toolbar application-toolbar" method="get" action="/admin/applications">
  <div class="toolbar-search"><i class="fa-solid fa-magnifying-glass"></i><input type="search" name="q" value="<%= search %>" placeholder="Search applicant, email, position or reference…" aria-label="Search job applications"></div>
  <div class="toolbar-filter"><i class="fa-solid fa-filter"></i><select name="status" aria-label="Filter applications by status"><option value="all" <%= status === 'all' ? 'selected' : '' %>>All statuses</option><option value="new" <%= status === 'new' ? 'selected' : '' %>>New</option><option value="reviewing" <%= status === 'reviewing' ? 'selected' : '' %>>Reviewing</option><option value="interview" <%= status === 'interview' ? 'selected' : '' %>>Interview</option><option value="hired" <%= status === 'hired' ? 'selected' : '' %>>Hired</option><option value="not-selected" <%= status === 'not-selected' ? 'selected' : '' %>>Not selected</option></select></div>
  <button class="admin-btn primary" type="submit"><i class="fa-solid fa-arrow-right"></i> Apply filters</button>
  <% if (search || status !== 'all') { %><a class="admin-btn subtle" href="/admin/applications"><i class="fa-solid fa-xmark"></i> Clear</a><% } %>
  <span class="toolbar-count"><strong><%= applications.length %></strong> shown</span>
</form>

<div class="applications-admin-layout">
  <aside class="admin-panel application-inbox" aria-label="Applicant inbox">
    <header class="application-inbox-head"><div><span class="panel-icon"><i class="fa-regular fa-file-lines"></i></span><div><h2>Applicant inbox</h2><p>Newest submissions first</p></div></div><a href="/apply" target="_blank" rel="noopener" title="Open public application" aria-label="Open public application"><i class="fa-solid fa-arrow-up-right-from-square"></i></a></header>
    <% if (applications.length) { %>
      <div class="application-list">
        <% applications.forEach(application => { %>
          <a class="application-list-item <%= selected && String(selected._id) === String(application._id) ? 'selected' : '' %>" href="/admin/applications?status=<%= status %>&amp;q=<%= encodeURIComponent(search) %>&amp;id=<%= application._id %>">
            <span class="application-avatar"><%= application.fullName.split(/\s+/).slice(0,2).map(part=>part.charAt(0).toUpperCase()).join('') %></span>
            <span class="application-list-copy"><span><strong><%= application.fullName %></strong><time><%= new Date(application.createdAt).toLocaleDateString('en-US',{month:'short',day:'numeric'}) %></time></span><small><%= application.position %> · <%= application.employmentType %></small><span><b class="status-badge <%= application.status %>"><i></i><%= statusLabel(application.status) %></b><em><%= application.applicationNumber %></em></span></span>
          </a>
        <% }) %>
      </div>
    <% } else { %>
      <div class="admin-empty compact"><span><i class="fa-regular fa-file-lines"></i></span><h2>No applications found</h2><p>New employment applications will appear here immediately after submission.</p><a class="admin-btn primary" href="/apply" target="_blank" rel="noopener">Open Application Form</a></div>
    <% } %>
  </aside>

  <section class="admin-panel application-detail">
    <% if (selected) { %>
      <header class="application-detail-head">
        <div class="applicant-title"><span class="application-avatar large"><%= selected.fullName.split(/\s+/).slice(0,2).map(part=>part.charAt(0).toUpperCase()).join('') %></span><div><span class="status-badge <%= selected.status %>"><i></i><%= statusLabel(selected.status) %></span><h2><%= selected.fullName %></h2><p><%= selected.position %> · <%= selected.employmentType %></p></div></div>
        <div class="application-head-actions"><% if(selected.resumePath){ %><a class="admin-btn subtle" href="/admin/applications/<%= selected._id %>/resume"><i class="fa-solid fa-download"></i> Résumé</a><% } %><a class="admin-btn primary" href="mailto:<%= selected.email %>"><i class="fa-regular fa-envelope"></i> Email applicant</a></div>
      </header>

      <div class="application-reference-bar"><span><small>Application reference</small><strong><%= selected.applicationNumber %></strong></span><span><small>Submitted</small><strong><%= new Date(selected.createdAt).toLocaleString('en-US',{month:'long',day:'numeric',year:'numeric',hour:'numeric',minute:'2-digit'}) %></strong></span><span><small>Available</small><strong><%= selected.dateAvailable %></strong></span><span><small>Last reviewed</small><strong><%= selected.reviewedAt ? new Date(selected.reviewedAt).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : 'Not yet' %></strong></span></div>

      <div class="application-detail-body">
        <section class="application-record-section">
          <header><span><i class="fa-regular fa-address-card"></i></span><div><h3>Personal &amp; position details</h3><p>Applicant contact details and employment preferences.</p></div></header>
          <dl class="record-grid"><div><dt>Email</dt><dd><a href="mailto:<%= selected.email %>"><%= selected.email %></a></dd></div><div><dt>Phone</dt><dd><a href="tel:<%= selected.phone.replace(/[^0-9+]/g,'') %>"><%= selected.phone %></a></dd></div><div class="wide"><dt>Current address</dt><dd><%= selected.address %>, <%= selected.city %>, <%= selected.state %> <%= selected.zip %></dd></div><div><dt>Position</dt><dd><%= selected.position %></dd></div><div><dt>Employment desired</dt><dd><%= selected.employmentType %></dd></div><div><dt>Desired pay</dt><dd><%= selected.desiredPay ? '$' + selected.desiredPay + (selected.desiredPayType ? ' · ' + selected.desiredPayType : '') : 'Not provided' %></dd></div><div><dt>Date available</dt><dd><%= selected.dateAvailable %></dd></div></dl>
        </section>

        <details class="application-record-section" open><summary><span class="record-summary-icon"><i class="fa-solid fa-clipboard-check"></i></span><span class="record-summary-copy"><strong>Employment eligibility</strong><small>Work authorization and screening responses.</small></span><i class="fa-solid fa-chevron-down"></i></summary><dl class="record-grid"><div><dt>U.S. citizen</dt><dd><%= answer(selected.usCitizen) %></dd></div><div><dt>Authorized to work</dt><dd><%= selected.usCitizen === 'yes' ? 'Citizen' : answer(selected.allowedToWork) %></dd></div><div><dt>Worked here before</dt><dd><%= answer(selected.previouslyWorked) %><%= selected.priorEmploymentDates ? ' · ' + selected.priorEmploymentDates : '' %></dd></div><div><dt>Felony conviction</dt><dd><%= answer(selected.felonyConviction) %></dd></div><% if(selected.felonyExplanation){ %><div class="wide"><dt>Applicant explanation</dt><dd class="long-copy"><%= selected.felonyExplanation %></dd></div><% } %><div><dt>Background-check consent</dt><dd><%= answer(selected.backgroundCheckConsent) %></dd></div></dl></details>

        <details class="application-record-section" open><summary><span class="record-summary-icon"><i class="fa-solid fa-graduation-cap"></i></span><span class="record-summary-copy"><strong>Education</strong><small>Schools, credentials and relevant training.</small></span><i class="fa-solid fa-chevron-down"></i></summary><div class="record-cards"><% if(selected.education?.some(item=>item.school)){ selected.education.filter(item=>item.school).forEach(item=>{ %><article><span><%= item.level || 'Education' %></span><h4><%= item.school %></h4><p><%= item.cityState || 'Location not provided' %></p><dl><div><dt>Dates</dt><dd><%= [item.from,item.to].filter(Boolean).join(' – ') || 'Not provided' %></dd></div><div><dt>Graduated</dt><dd><%= answer(item.graduated) %></dd></div><div><dt>Credential</dt><dd><%= item.credential || 'Not provided' %></dd></div></dl></article><% }) } else { %><p class="record-empty">No education details were provided.</p><% } %></div></details>

        <details class="application-record-section" open><summary><span class="record-summary-icon"><i class="fa-solid fa-briefcase"></i></span><span class="record-summary-copy"><strong>Employment history</strong><small>Previous roles and responsibilities.</small></span><i class="fa-solid fa-chevron-down"></i></summary><div class="employment-records"><% if(selected.employmentHistory?.some(item=>item.employer)){ selected.employmentHistory.filter(item=>item.employer).forEach((item,index)=>{ %><article><header><span><%= index + 1 %></span><div><h4><%= item.employer %></h4><p><%= item.jobTitle || 'Job title not provided' %></p></div><time><%= [item.startDate,item.endDate].filter(Boolean).join(' – ') || 'Dates not provided' %></time></header><dl class="record-grid"><div><dt>Phone</dt><dd><%= item.phone || 'Not provided' %></dd></div><div><dt>Email</dt><dd><%= item.email || 'Not provided' %></dd></div><div class="wide"><dt>Address</dt><dd><%= [item.address,item.city,item.state,item.zip].filter(Boolean).join(', ') || 'Not provided' %></dd></div><div><dt>Starting pay</dt><dd><%= item.startingPay || 'Not provided' %></dd></div><div><dt>Ending pay</dt><dd><%= item.endingPay || 'Not provided' %></dd></div><div class="wide"><dt>Responsibilities</dt><dd class="long-copy"><%= item.responsibilities || 'Not provided' %></dd></div><div class="wide"><dt>Reason for leaving</dt><dd><%= item.reasonForLeaving || 'Not provided' %></dd></div></dl></article><% }) } else { %><p class="record-empty">No previous employment was listed.</p><% } %></div></details>

        <details class="application-record-section"><summary><span class="record-summary-icon"><i class="fa-solid fa-user-group"></i></span><span class="record-summary-copy"><strong>Professional references</strong><small>People provided to verify experience and character.</small></span><i class="fa-solid fa-chevron-down"></i></summary><div class="reference-records"><% selected.references?.filter(item=>item.name).forEach(item=>{ %><article><span class="application-avatar"><%= item.name.charAt(0).toUpperCase() %></span><div><h4><%= item.name %></h4><p><%= [item.title,item.company].filter(Boolean).join(' · ') || item.relationship || 'Professional reference' %></p><span><% if(item.email){ %><a href="mailto:<%= item.email %>"><i class="fa-regular fa-envelope"></i><%= item.email %></a><% } %><% if(item.phone){ %><a href="tel:<%= item.phone.replace(/[^0-9+]/g,'') %>"><i class="fa-solid fa-phone"></i><%= item.phone %></a><% } %></span></div></article><% }) %></div></details>

        <details class="application-record-section"><summary><span class="record-summary-icon"><i class="fa-solid fa-medal"></i></span><span class="record-summary-copy"><strong>Military service &amp; certification</strong><small>Service details and electronic signature.</small></span><i class="fa-solid fa-chevron-down"></i></summary><dl class="record-grid"><div><dt>Veteran</dt><dd><%= answer(selected.veteran) %></dd></div><div><dt>Branch</dt><dd><%= selected.militaryBranch || 'Not applicable' %></dd></div><div><dt>Rank at discharge</dt><dd><%= selected.rankAtDischarge || 'Not applicable' %></dd></div><div><dt>Service dates</dt><dd><%= [selected.militaryStartDate,selected.militaryEndDate].filter(Boolean).join(' – ') || 'Not applicable' %></dd></div><div><dt>Discharge type</dt><dd><%= selected.dischargeType || 'Not applicable' %></dd></div><div><dt>Certification accepted</dt><dd><%= selected.certificationAccepted ? 'Yes' : 'No' %></dd></div><div><dt>Electronic signature</dt><dd><%= selected.signature %></dd></div><div><dt>Signature date</dt><dd><%= selected.signatureDate %></dd></div><% if(selected.dischargeExplanation){ %><div class="wide"><dt>Discharge explanation</dt><dd class="long-copy"><%= selected.dischargeExplanation %></dd></div><% } %></dl></details>
      </div>

      <aside class="application-management" aria-label="Application management">
        <form class="application-manage-form" method="post" action="/admin/applications/<%= selected._id %>"><input type="hidden" name="returnStatus" value="<%= status %>"><div><span class="management-icon"><i class="fa-solid fa-list-check"></i></span><div><h3>Hiring workflow</h3><p>Update status and keep private review notes.</p></div></div><label><span>Application status</span><select name="status"><option value="new" <%= selected.status === 'new' ? 'selected' : '' %>>New</option><option value="reviewing" <%= selected.status === 'reviewing' ? 'selected' : '' %>>Reviewing</option><option value="interview" <%= selected.status === 'interview' ? 'selected' : '' %>>Interview</option><option value="hired" <%= selected.status === 'hired' ? 'selected' : '' %>>Hired</option><option value="not-selected" <%= selected.status === 'not-selected' ? 'selected' : '' %>>Not selected</option></select></label><label><span>Private administrator notes</span><textarea name="adminNotes" maxlength="5000" rows="5" placeholder="Interview dates, follow-up actions or internal observations…"><%= selected.adminNotes || '' %></textarea></label><button class="admin-btn primary" type="submit"><i class="fa-solid fa-floppy-disk"></i> Save Application Update</button></form>
        <form method="post" action="/admin/applications/<%= selected._id %>?_method=DELETE" data-confirm="Permanently delete this application and its uploaded résumé? This cannot be undone."><button class="application-delete" type="submit"><i class="fa-regular fa-trash-can"></i> Delete application permanently</button></form>
      </aside>
    <% } else { %>
      <div class="application-detail-empty"><span><i class="fa-regular fa-file-lines"></i></span><h2>Select an application</h2><p>Choose an applicant from the inbox to review their complete submission and update the hiring workflow.</p></div>
    <% } %>
  </section>
</div>
<%- include('../partials/admin-foot') %>
