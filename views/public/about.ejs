<%- include('../partials/head',{title}) %>
<%- include('../partials/header',{settings}) %>
<main id="main-content">
  <%- include('../partials/public-hero') %>
  <% const storySection = pageSections.find(s=>s.seedKey==='about-story'); if(storySection){ %><%- include('../partials/page-section',{section:storySection,settings}) %><% } %>
  <section class="purpose-band"><div class="container purpose-grid"><article class="reveal"><span class="eyebrow">Our purpose</span><h2>To help every resident live a fulfilling, balanced life.</h2></article><article class="reveal"><p>We support graceful aging across four connected dimensions.</p><div class="dimension-grid"><span><i class="fa-solid fa-person-walking"></i> Physical</span><span><i class="fa-solid fa-face-smile"></i> Emotional</span><span><i class="fa-solid fa-dove"></i> Spiritual</span><span><i class="fa-solid fa-stethoscope"></i> Medical</span></div></article></div></section>
  <section class="section values-section"><div class="container"><div class="section-heading centered reveal"><span class="eyebrow dark">What guides us</span><h2>Values you can feel in everyday care.</h2></div><div class="value-grid"><article class="value-card reveal"><span><i class="fa-solid fa-heart"></i></span><h3>Compassion</h3><p>We meet needs with patience, kindness and genuine human warmth.</p></article><article class="value-card reveal"><span><i class="fa-solid fa-hand-holding-heart"></i></span><h3>Dignity</h3><p>We preserve choice, privacy, identity and respect at every stage.</p></article><article class="value-card reveal"><span><i class="fa-solid fa-cross"></i></span><h3>Faith</h3><p>Christian values shape a culture of service, hope and belonging.</p></article><article class="value-card reveal"><span><i class="fa-solid fa-user-group"></i></span><h3>Family</h3><p>Residents and their loved ones remain included, heard and connected.</p></article></div></div></section>
  <% const teamSection = pageSections.find(s=>s.seedKey==='about-team'); if(teamSection){ %><%- include('../partials/page-section',{section:teamSection,settings}) %><% } %>
</main>
<%- include('../partials/footer',{settings}) %>
