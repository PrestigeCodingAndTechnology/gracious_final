<%- include('../partials/head',{title}) %>
<%- include('../partials/header',{settings}) %>
<main id="main-content">
  <%- include('../partials/public-hero') %>
  <section class="section">
    <div class="container split split-feature">
      <div class="section-copy reveal"><span class="eyebrow dark">Our story</span><h2>Graceful aging begins with being genuinely known.</h2><p class="lead">Gracious Senior Living is a warm residential community led by a family of physicians and created for people who deserve care that feels personal.</p><p>Unlike large traditional facilities, our six-room home allows caregivers to notice the details: a favorite routine, a meaningful story, a change in appetite, or the simple comfort of a familiar voice. That closeness helps us respond with attentiveness and compassion.</p><p>Here, residents are not numbers on a schedule. They are individuals with histories, preferences, relationships and purpose—and they are welcomed as part of the Gracious family.</p></div>
      <div class="image-composition about-image reveal"><img class="image-main" src="/media/gallery/g7.jpeg" alt="Women residents gathered in the Gracious Senior Living lounge"><div class="image-note"><i class="fa-solid fa-people-roof"></i><span><strong>Six private rooms</strong>Care that never feels crowded.</span></div></div>
    </div>
  </section>
  <section class="purpose-band">
    <div class="container purpose-grid">
      <article class="reveal"><span class="eyebrow">Our purpose</span><h2>To help every resident live a fulfilling, balanced life.</h2></article>
      <article class="reveal"><p>We support graceful aging across four connected dimensions.</p><div class="dimension-grid"><span><i class="fa-solid fa-person-walking"></i> Physical</span><span><i class="fa-solid fa-face-smile"></i> Emotional</span><span><i class="fa-solid fa-dove"></i> Spiritual</span><span><i class="fa-solid fa-stethoscope"></i> Medical</span></div></article>
    </div>
  </section>
  <section class="section values-section">
    <div class="container"><div class="section-heading centered reveal"><span class="eyebrow dark">What guides us</span><h2>Values you can feel in everyday care.</h2></div><div class="value-grid">
      <article class="value-card reveal"><span><i class="fa-solid fa-heart"></i></span><h3>Compassion</h3><p>We meet needs with patience, kindness and genuine human warmth.</p></article>
      <article class="value-card reveal"><span><i class="fa-solid fa-hand-holding-heart"></i></span><h3>Dignity</h3><p>We preserve choice, privacy, identity and respect at every stage.</p></article>
      <article class="value-card reveal"><span><i class="fa-solid fa-cross"></i></span><h3>Faith</h3><p>Christian values shape a culture of service, hope and belonging.</p></article>
      <article class="value-card reveal"><span><i class="fa-solid fa-user-group"></i></span><h3>Family</h3><p>Residents and their loved ones remain included, heard and connected.</p></article>
    </div></div>
  </section>
  <section class="section team-section">
    <div class="container split split-feature reverse-mobile"><div class="team-image reveal"><img src="/media/gallery/g5.jpeg" alt="Two women residents sharing a happy moment at Gracious Senior Living"></div><div class="section-copy reveal"><span class="eyebrow dark">Our care team</span><h2>Professional expertise with a family heart.</h2><p class="lead">Board-certified physicians, nurses, certified nursing assistants and licensed caregivers work together to provide attentive, coordinated support.</p><p>Our administrative team helps personalize care plans, coordinate schedules and keep families informed. Across every role, the standard is the same: empathy, professionalism and genuine concern for the person in our care.</p><a class="btn btn-primary" href="/care">Explore Our Care <i class="fa-solid fa-arrow-right"></i></a></div></div>
  </section>
</main>
<%- include('../partials/footer',{settings}) %>
