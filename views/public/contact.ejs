<%- include('../partials/head',{title}) %>
<%- include('../partials/header',{settings}) %>
<main id="main-content">
  <%- include('../partials/public-hero') %>
  <section class="contact-cards"><div class="container contact-card-grid">
    <a class="contact-card reveal" href="tel:<%= (settings.phone || '704-218-2424').replace(/[^0-9+]/g,'') %>"><span><i class="fa-solid fa-phone"></i></span><div><small>Call our main line</small><strong><%= settings.phone || '704-218-2424' %></strong><em>Speak with our team</em></div><i class="fa-solid fa-arrow-right"></i></a>
    <a class="contact-card reveal" href="mailto:<%= settings.email || 'info@graciouscarenc.com' %>"><span><i class="fa-regular fa-envelope"></i></span><div><small>Send an email</small><strong><%= settings.email || 'info@graciouscarenc.com' %></strong><em>We’ll respond as soon as possible</em></div><i class="fa-solid fa-arrow-right"></i></a>
    <a class="contact-card reveal" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(settings.address) %>" target="_blank" rel="noopener"><span><i class="fa-solid fa-location-dot"></i></span><div><small>Visit by appointment</small><strong><%= settings.address || '5402 Weddington Road, Wesley Chapel NC 28110' %></strong><em>Open directions</em></div><i class="fa-solid fa-arrow-right"></i></a>
  </div></section>
  <section class="section contact-main"><div class="container contact-layout"><div class="contact-copy reveal"><span class="eyebrow dark">We’d love to hear from you</span><h2>Tell us how we can assist.</h2><p class="lead">Choosing care is a deeply personal decision. Share a little about what you are looking for and a member of our team will follow up.</p><div class="contact-expect"><article><span>1</span><div><h3>Send your inquiry</h3><p>Let us know whether you need care information, availability or a tour.</p></div></article><article><span>2</span><div><h3>We’ll listen first</h3><p>Our team will learn about your loved one, priorities and timing.</p></div></article><article><span>3</span><div><h3>Plan a visit</h3><p>Tour the home, meet the team and get clear answers in person.</p></div></article></div></div><form class="public-form contact-form reveal" method="post" action="/contact"><label class="honeypot" aria-hidden="true">Leave this field empty<input name="website" tabindex="-1" autocomplete="off"></label><div class="form-heading"><span><i class="fa-regular fa-calendar-check"></i></span><div><h3>Request information or a tour</h3><p>Fields marked with * are required.</p></div></div><div class="field-row"><label><span>First name *</span><input required name="firstName" maxlength="60" autocomplete="given-name" placeholder="First name"></label><label><span>Last name</span><input name="lastName" maxlength="60" autocomplete="family-name" placeholder="Last name"></label></div><div class="field-row"><label><span>Email address *</span><input required type="email" name="email" maxlength="160" autocomplete="email" placeholder="you@example.com"></label><label><span>Phone number</span><input type="tel" name="phone" maxlength="30" autocomplete="tel" placeholder="(000) 000-0000"></label></div><label><span>I’m interested in</span><select name="interest"><option value="">Choose an option</option><option>Scheduling a personal tour</option><option>Care and service information</option><option>Current room availability</option><option>Respite or short-term care</option><option>General question</option></select></label><label><span>How can we help? *</span><textarea required name="message" maxlength="2500" rows="6" placeholder="Tell us a little about your loved one, care needs or questions…"></textarea><small><span data-character-count>0</span>/2500 characters</small></label><button class="btn btn-gold submit-btn" type="submit"><span>Send Inquiry</span><i class="fa-solid fa-paper-plane"></i></button><p class="form-privacy"><i class="fa-solid fa-lock"></i> Your information is private and used only to respond to this inquiry.</p></form></div></section>
  <section class="map-section"><iframe title="Map showing Gracious Senior Living" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://maps.google.com/maps?q=<%= encodeURIComponent(settings.address || '5402 Weddington Road, Wesley Chapel NC 28110') %>&amp;output=embed"></iframe><div class="map-card reveal"><span class="eyebrow dark">Our location</span><h2>Visit Gracious Senior Living.</h2><p><%= settings.address || '5402 Weddington Road, Wesley Chapel NC 28110' %></p><a class="btn btn-primary" href="https://www.google.com/maps/dir/?api=1&amp;destination=<%= encodeURIComponent(settings.address || '5402 Weddington Road, Wesley Chapel NC 28110') %>" target="_blank" rel="noopener">Get Directions <i class="fa-solid fa-arrow-up-right-from-square"></i></a></div></section>
</main>
<%- include('../partials/footer',{settings}) %>
