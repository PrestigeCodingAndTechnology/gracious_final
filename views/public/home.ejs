<%- include('../partials/head',{title}) %>
<%- include('../partials/header',{settings}) %>
<main id="main-content">
  <%- include('../partials/public-hero') %>

  <section class="assurance-bar" aria-label="Community highlights">
    <div class="container assurance-grid">
      <article><i class="fa-solid fa-house"></i><div><strong>6 Private Rooms</strong><span>Intimate, familiar living</span></div></article>
      <article><i class="fa-solid fa-clock"></i><div><strong>24/7 Support</strong><span>Attentive care day and night</span></div></article>
      <article><i class="fa-solid fa-stethoscope"></i><div><strong>Physician-Led</strong><span>Professional care coordination</span></div></article>
      <article><i class="fa-solid fa-shield-heart"></i><div><strong>Secure &amp; Peaceful</strong><span>A protected home environment</span></div></article>
    </div>
  </section>

  <% const welcomeSection = pageSections.find(s=>s.seedKey==='home-welcome'); if(welcomeSection){ %><%- include('../partials/page-section',{section:welcomeSection,settings}) %><% } %>

  <section class="section services-section">
    <div class="container">
      <div class="section-heading centered reveal"><span class="eyebrow dark">Care with intention</span><h2>Everything needed for safer, fuller days.</h2><p>Support is shaped around the resident—not the other way around.</p></div>
      <div class="service-grid">
        <article class="service-card reveal"><span class="service-number">01</span><i class="fa-solid fa-hands-holding-circle"></i><h3>Personal Care</h3><p>Respectful support with bathing, dressing, grooming, mobility and other daily needs.</p><a href="/care">Learn more <i class="fa-solid fa-arrow-right"></i></a></article>
        <article class="service-card reveal"><span class="service-number">02</span><i class="fa-solid fa-capsules"></i><h3>Health &amp; Medication</h3><p>Medication assistance, health observation and coordination with families and providers.</p><a href="/care">Learn more <i class="fa-solid fa-arrow-right"></i></a></article>
        <article class="service-card reveal"><span class="service-number">03</span><i class="fa-solid fa-people-roof"></i><h3>Meaningful Living</h3><p>Companionship, activities, outings and spiritual support that nurture belonging.</p><a href="/living">Learn more <i class="fa-solid fa-arrow-right"></i></a></article>
        <article class="service-card reveal"><span class="service-number">04</span><i class="fa-solid fa-brain"></i><h3>Specialized Support</h3><p>Thoughtful memory, respite and comfort-focused care in a calm residential setting.</p><a href="/care#specialized-care">Learn more <i class="fa-solid fa-arrow-right"></i></a></article>
      </div>
    </div>
  </section>

  <% const homeLife = pageSections.find(s=>s.seedKey==='home-life'); if(homeLife){ %><%- include('../partials/page-section',{section:homeLife,settings}) %><% } %>

  <section class="section journey-section"><div class="container"><div class="section-heading centered reveal"><span class="eyebrow dark">A thoughtful transition</span><h2>From first conversation to feeling at home.</h2></div><div class="journey-grid">
    <article class="reveal"><span>1</span><h3>Let’s Talk</h3><p>Share what your family needs and ask every question on your mind.</p></article>
    <article class="reveal"><span>2</span><h3>Tour the Home</h3><p>Visit the living spaces, meet our team and experience the atmosphere.</p></article>
    <article class="reveal"><span>3</span><h3>Plan Together</h3><p>We create a personal approach around routines, health and preferences.</p></article>
    <article class="reveal"><span>4</span><h3>Welcome Home</h3><p>We support a comfortable transition and keep your family connected.</p></article>
  </div></div></section>

  <section class="section testimonials-section"><div class="container"><div class="testimonial-heading reveal"><div><span class="eyebrow dark">Family voices</span><h2>Care felt. Trust shared.</h2></div><div class="testimonial-actions"><a class="text-link" href="/reviews">View all reviews <i class="fa-solid fa-arrow-right"></i></a><div class="carousel-buttons"><button type="button" data-review-prev aria-label="Previous reviews"><i class="fa-solid fa-arrow-left"></i></button><button type="button" data-review-next aria-label="Next reviews"><i class="fa-solid fa-arrow-right"></i></button></div></div></div><div class="review-track" data-review-track>
    <% if(reviews.length){ reviews.forEach(r=>{ %><article class="review-card reveal"><div class="quote-mark"><i class="fa-solid fa-quote-left"></i></div><div class="stars" role="img" aria-label="<%= r.rating %> out of 5 stars"><%= '★'.repeat(r.rating) %><span><%= '★'.repeat(5-r.rating) %></span></div><blockquote><%= r.message %></blockquote><div class="reviewer"><span><%= r.name.charAt(0).toUpperCase() %></span><div><strong><%= r.name %></strong><small><%= r.relationship || 'Gracious community' %></small></div></div></article><% }) } else { %><article class="review-card review-empty reveal"><i class="fa-regular fa-message"></i><h3>Family stories belong here.</h3><p>Approved reviews will appear as families share their experiences.</p><a class="text-link" href="/reviews#review-form">Share your experience <i class="fa-solid fa-arrow-right"></i></a></article><% } %>
  </div><div class="review-share-cta reveal"><p>Have an experience to share? Your review will appear here after administrator approval.</p><a class="btn btn-primary" href="/reviews#review-form">Write a Review <i class="fa-solid fa-arrow-right"></i></a></div></div></section>

  <% const visitSection = pageSections.find(s=>s.seedKey==='home-visit'); if(visitSection){ %><%- include('../partials/page-section',{section:visitSection,settings}) %><% } %>
</main>
<%- include('../partials/footer',{settings}) %>
