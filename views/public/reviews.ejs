<%- include('../partials/head',{title}) %>
<%- include('../partials/header',{settings}) %>
<% const averageRating = reviews.length ? (reviews.reduce((sum, review) => sum + review.rating, 0) / reviews.length).toFixed(1) : '—'; %>
<main id="main-content">
  <%- include('../partials/public-hero') %>
  <section class="review-summary"><div class="container summary-grid"><div><strong><%= averageRating %></strong><div><span class="stars"><%= reviews.length ? '★'.repeat(Math.round(Number(averageRating))) : '☆☆☆☆☆' %></span><small>Average from <%= reviews.length %> approved <%= reviews.length === 1 ? 'review' : 'reviews' %></small></div></div><p>Every family’s perspective matters. Reviews are moderated only for privacy and appropriateness before publication.</p><a class="btn btn-primary" href="#review-form">Share Your Experience <i class="fa-solid fa-arrow-down"></i></a></div></section>
  <section class="section reviews-list-section"><div class="container">
    <% if (reviews.length) { %><div class="reviews-masonry"><% reviews.forEach(r=>{ %><article class="review-page-card reveal"><i class="fa-solid fa-quote-left"></i><div class="stars" role="img" aria-label="<%= r.rating %> out of 5 stars"><%= '★'.repeat(r.rating) %><span><%= '★'.repeat(5-r.rating) %></span></div><blockquote><%= r.message %></blockquote><div class="reviewer"><span><%= r.name.charAt(0).toUpperCase() %></span><div><strong><%= r.name %></strong><small><%= r.relationship || 'Gracious community' %></small></div></div></article><% }) %></div>
    <% } else { %><div class="empty-state reveal"><i class="fa-regular fa-star"></i><h2>Be the first to share an experience.</h2><p>Approved reviews will be displayed here for families exploring Gracious Senior Living.</p><a class="btn btn-primary" href="#review-form">Leave a Review</a></div><% } %>
  </div></section>

  <div class="review-feedback" id="review-feedback" data-review-feedback role="status" aria-live="polite" hidden>
    <div class="review-feedback-icon"><i class="fa-solid fa-check"></i></div>
    <div><span class="eyebrow dark">Review received</span><h3>Thank you for sharing your experience.</h3><p data-review-feedback-message>Your review is safely with our team and is awaiting administrator approval before it appears publicly.</p><div class="review-feedback-steps"><span><i class="fa-solid fa-check"></i> Submitted</span><span><i class="fa-solid fa-hourglass-half"></i> Moderation</span><span><i class="fa-regular fa-eye"></i> Published after approval</span></div></div>
    <button type="button" data-review-feedback-close aria-label="Dismiss review confirmation"><i class="fa-solid fa-xmark"></i></button>
  </div>
  <section class="section review-form-section" id="review-form"><div class="container review-form-layout"><div class="review-form-copy reveal"><span class="eyebrow">Share your experience</span><h2>Your words can help another family.</h2><p>Tell us what stood out about your experience with Gracious Senior Living. Your review will be sent privately to our team for approval before it appears on the site.</p><ul><li><i class="fa-solid fa-circle-check"></i> Submitted securely</li><li><i class="fa-solid fa-circle-check"></i> Reviewed before publishing</li><li><i class="fa-solid fa-circle-check"></i> Your contact details are not displayed</li></ul></div><form class="public-form review-form reveal" method="post" action="/reviews" data-review-form><div class="form-heading"><span><i class="fa-regular fa-pen-to-square"></i></span><div><h3>Leave a review</h3><p>Fields marked with * are required.</p></div></div><div class="field-row"><label><span>Your name *</span><input required name="name" maxlength="80" autocomplete="name" placeholder="Full name"></label><label><span>Relationship</span><input name="relationship" maxlength="100" placeholder="Family member, visitor, etc."></label></div><fieldset class="rating-field"><legend>Your rating *</legend><div class="star-picker"><input type="radio" id="rating5" name="rating" value="5" checked><label for="rating5" title="Excellent">★</label><input type="radio" id="rating4" name="rating" value="4"><label for="rating4" title="Very good">★</label><input type="radio" id="rating3" name="rating" value="3"><label for="rating3" title="Good">★</label><input type="radio" id="rating2" name="rating" value="2"><label for="rating2" title="Fair">★</label><input type="radio" id="rating1" name="rating" value="1"><label for="rating1" title="Poor">★</label></div></fieldset><label><span>Your review *</span><textarea required name="message" maxlength="1200" rows="6" placeholder="Share your experience with Gracious Senior Living…"></textarea><small><span data-character-count>0</span>/1200 characters</small></label><button class="btn btn-gold submit-btn" type="submit"><span>Submit Review</span><i class="fa-solid fa-arrow-right"></i></button></form></div></section>
</main>
<%- include('../partials/footer',{settings}) %>
