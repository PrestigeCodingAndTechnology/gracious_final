<% const pageDescriptions = { 'Dashboard':'A clear view of messages, inquiries, applications, reviews and website content.', 'Live Chat':'Speak with website visitors and support families in real time.', 'Manage Reviews':'Moderate family feedback before it appears on the public website.', 'Contact Inquiries':'Track every family inquiry, follow-up status and private note.', 'Job Applications':'Review candidates, résumés and hiring progress in one secure workspace.', 'Hero Sections':'Manage every public hero background, slider, headline, supporting text and call to action.', 'Photos Gallery':'Manage public photographs independently from videos.', 'Videos Gallery':'Manage public videos independently from photographs.', 'Media Library':'Legacy combined media management.', 'Site Settings':'Update public contact details and website-wide service settings.' }; %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#102e28">
  <title><%= title %> | Gracious Administration</title>
  <link rel="icon" type="image/png" href="/media/brand/gracious-logo.png">
  <link rel="apple-touch-icon" href="/media/brand/gracious-logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <aside class="admin-sidebar" id="adminSidebar" aria-label="Administration navigation">
      <a class="admin-brand" href="/admin"><img class="admin-brand-logo" src="/media/brand/gracious-logo.png" alt="Gracious Senior Living"><small>Administration</small></a>
      <div class="workspace-label"><span>Website workspace</span><i class="fa-solid fa-circle-check" title="Connected"></i></div>
      <nav class="admin-nav" aria-label="Administration sections">
        <span class="nav-label">Overview</span>
        <a class="<%= currentPath === '/admin' || currentPath === '/admin/' ? 'active' : '' %>" href="/admin" aria-current="<%= currentPath === '/admin' || currentPath === '/admin/' ? 'page' : 'false' %>"><i class="fa-solid fa-table-cells-large"></i><span>Dashboard</span></a>
        <a class="<%= currentPath.startsWith('/admin/chats') ? 'active' : '' %>" href="/admin/chats" aria-current="<%= currentPath.startsWith('/admin/chats') ? 'page' : 'false' %>"><i class="fa-regular fa-comments"></i><span>Live Chat</span><b class="nav-count" id="adminChatBadge" <%= adminUnreadChat ? '' : 'hidden' %>><%= adminUnreadChat || 0 %></b></a>
        <span class="nav-label">Engagement</span>
        <a class="<%= currentPath.startsWith('/admin/inquiries') ? 'active' : '' %>" href="/admin/inquiries" aria-current="<%= currentPath.startsWith('/admin/inquiries') ? 'page' : 'false' %>"><i class="fa-regular fa-envelope-open"></i><span>Inquiries</span><b class="nav-count inquiries" id="adminInquiryBadge" <%= adminNewInquiries ? '' : 'hidden' %>><%= adminNewInquiries || 0 %></b></a>
        <a class="<%= currentPath.startsWith('/admin/applications') ? 'active' : '' %>" href="/admin/applications" aria-current="<%= currentPath.startsWith('/admin/applications') ? 'page' : 'false' %>"><i class="fa-regular fa-file-lines"></i><span>Applications</span><b class="nav-count applications" id="adminApplicationBadge" <%= adminNewApplications ? '' : 'hidden' %>><%= adminNewApplications || 0 %></b></a>
        <a class="<%= currentPath.startsWith('/admin/reviews') ? 'active' : '' %>" href="/admin/reviews" aria-current="<%= currentPath.startsWith('/admin/reviews') ? 'page' : 'false' %>"><i class="fa-regular fa-star"></i><span>Reviews</span><b class="nav-count reviews" id="adminReviewBadge" <%= adminPendingReviews ? '' : 'hidden' %>><%= adminPendingReviews || 0 %></b></a>
        <span class="nav-label">Website</span>
        <a class="<%= currentPath.startsWith('/admin/heroes') ? 'active' : '' %>" href="/admin/heroes" aria-current="<%= currentPath.startsWith('/admin/heroes') ? 'page' : 'false' %>"><i class="fa-solid fa-panorama"></i><span>Hero Sections</span></a>
        <a class="<%= currentPath.startsWith('/admin/photos') ? 'active' : '' %>" href="/admin/photos" aria-current="<%= currentPath.startsWith('/admin/photos') ? 'page' : 'false' %>"><i class="fa-regular fa-images"></i><span>Photos Gallery</span></a>
        <a class="<%= currentPath.startsWith('/admin/videos') ? 'active' : '' %>" href="/admin/videos" aria-current="<%= currentPath.startsWith('/admin/videos') ? 'page' : 'false' %>"><i class="fa-solid fa-film"></i><span>Videos Gallery</span></a>
        <a class="<%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>" href="/admin/settings" aria-current="<%= currentPath.startsWith('/admin/settings') ? 'page' : 'false' %>"><i class="fa-solid fa-sliders"></i><span>Site Settings</span></a>
      </nav>
      <div class="sidebar-footer">
        <a class="view-site-link" href="/" target="_blank" rel="noopener"><i class="fa-solid fa-arrow-up-right-from-square"></i><span>View public website</span></a>
        <div class="admin-user"><span class="user-avatar"><%= (currentUser?.name || 'A').charAt(0).toUpperCase() %></span><div><strong><%= currentUser?.name || 'Administrator' %></strong><small><%= currentUser?.email || 'Admin account' %></small></div><form action="/admin/logout" method="post"><button type="submit" title="Sign out" aria-label="Sign out"><i class="fa-solid fa-arrow-right-from-bracket"></i></button></form></div>
      </div>
    </aside>
    <button class="sidebar-scrim" id="sidebarScrim" type="button" aria-label="Close navigation" hidden></button>
    <div class="admin-workspace">
      <header class="admin-topbar">
        <div class="topbar-left"><button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Open administration navigation" aria-expanded="false"><i class="fa-solid fa-bars-staggered"></i></button><div><span>Gracious Senior Living</span><strong><%= title %></strong></div></div>
        <div class="topbar-actions"><span class="live-system"><i></i> Website live</span><span class="topbar-date"><i class="fa-regular fa-calendar"></i><%= new Date().toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></span><a href="/" target="_blank" rel="noopener" title="Open public website" aria-label="Open public website"><i class="fa-solid fa-arrow-up-right-from-square"></i></a></div>
      </header>
      <main class="admin-main">
        <section class="admin-page-heading"><div><span class="admin-eyebrow">Gracious workspace</span><h1><%= title %></h1><p><%= pageDescriptions[title] || 'Manage Gracious Senior Living.' %></p></div></section>
        <% if(success){ %><div class="admin-notice success" role="status"><span><i class="fa-solid fa-circle-check"></i><%= success %></span><button type="button" aria-label="Dismiss notification"><i class="fa-solid fa-xmark"></i></button></div><% } %>
        <% if(error){ %><div class="admin-notice error" role="alert"><span><i class="fa-solid fa-circle-exclamation"></i><%= error %></span><button type="button" aria-label="Dismiss notification"><i class="fa-solid fa-xmark"></i></button></div><% } %>
