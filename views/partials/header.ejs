<div class="topbar">
  <div class="container topbar-inner">
    <div class="topbar-contact">
      <a href="tel:<%= (settings?.phone || '704-218-2424').replace(/[^0-9+]/g,'') %>"><i class="fa-solid fa-phone"></i> <span><%= settings?.phone || '704-218-2424' %></span></a>
      <a href="mailto:<%= settings?.email || 'info@graciouscarenc.com' %>"><i class="fa-regular fa-envelope"></i> <span><%= settings?.email || 'info@graciouscarenc.com' %></span></a>
    </div>
    <a class="topbar-location" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(settings?.address || '5402 Weddington Road, Wesley Chapel NC 28110') %>" target="_blank" rel="noopener">
      <i class="fa-solid fa-location-dot"></i> <span><%= settings?.address || '5402 Weddington Road, Wesley Chapel NC 28110' %></span>
    </a>
  </div>
</div>
<header class="site-header" id="siteHeader">
  <div class="container nav-shell">
    <a class="site-brand" href="/" aria-label="Gracious Senior Living home">
      <img class="brand-logo" src="/media/brand/gracious-logo.png" alt="Gracious Senior Living">
    </a>
    <button class="menu-toggle" id="menuToggle" type="button" aria-label="Open navigation" aria-controls="primaryNav" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="primary-nav" id="primaryNav" aria-label="Primary navigation">
      <a class="<%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a>
      <a class="<%= currentPath === '/about' ? 'active' : '' %>" href="/about">About</a>
      <a class="<%= currentPath === '/care' ? 'active' : '' %>" href="/care">Our Care</a>
      <a class="<%= currentPath === '/living' ? 'active' : '' %>" href="/living">Living</a>
      <a class="<%= currentPath === '/gallery' || currentPath === '/video-gallery' ? 'active' : '' %>" href="/gallery">Gallery</a>
      <a class="<%= currentPath === '/apply' || currentPath === '/join-our-team' ? 'active' : '' %>" href="/apply">Careers</a>
      <a class="<%= currentPath === '/reviews' ? 'active' : '' %>" href="/reviews">Reviews</a>
      <a class="nav-cta" href="/contact"><span>Schedule a Visit</span><i class="fa-solid fa-arrow-right"></i></a>
    </nav>
  </div>
</header>
<div class="nav-scrim" id="navScrim" hidden></div>
<% if (success) { %><div class="flash success" role="status"><span><i class="fa-solid fa-circle-check"></i> <%= success %></span><button type="button" aria-label="Dismiss message"><i class="fa-solid fa-xmark"></i></button></div><% } %>
<% if (error) { %><div class="flash error" role="alert"><span><i class="fa-solid fa-circle-exclamation"></i> <%= error %></span><button type="button" aria-label="Dismiss message"><i class="fa-solid fa-xmark"></i></button></div><% } %>
